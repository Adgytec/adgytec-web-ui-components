{
    "name": "@adgytec/adgytec-web-ui-components",
    "private": false,
    "version": "2.3.1",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./styles/core.css": {
            "import": "./dist/assets/core.css"
        },
        "./styles/defaultTheme.css": {
            "import": "./dist/assets/defaultTheme.css"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "dev-host": "vite --host",
        "generate:index": "node src/scripts/generate-root-index.mjs",
        "build": "npm run generate:index && npm run lint  && npm run typecheck && vite build",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "release": "npm run build && npm publish --public",
        "test": "echo \"No tests\""
    },
    "peerDependencies": {
        "@internationalized/date": "^3.12.1",
        "clsx": ">=2.1.1",
        "lucide-react": "^1.8.0",
        "react": ">=19.2.3",
        "react-aria": "^3.48.0",
        "react-aria-components": ">=1.17.0",
        "react-dom": ">=19.2.3",
        "react-transition-group": "^4.4.5",
        "usehooks-ts": ">=3.1.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@internationalized/date": "^3.12.4",
        "@rolldown/plugin-babel": "^0.2.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-transition-group": "^4.4.12",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "clsx": "^2.1.1",
        "glob": "^14.0.3",
        "globals": "^17.13.0",
        "lightningcss": "^1.33.0",
        "lucide-react": "^1.64.0",
        "postcss-nesting": "^14.0.3",
        "react": "^19.3.1",
        "react-aria": "^3.53.1",
        "react-aria-components": "^1.22.1",
        "react-dom": "^19.3.1",
        "react-transition-group": "^4.4.5",
        "sonda": "^0.14.0",
        "typescript": "~7.0.2",
        "unplugin-dts": "^1.1.2",
        "usehooks-ts": "^3.1.1",
        "vite": "^8.3.5",
        "vite-plugin-lib-inject-css": "^2.2.2"
    },
    "author": {
        "name": "Adgytec",
        "email": "rohan@adgytec.in",
        "url": "https://adgytec.in"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Adgytec/adgytec-web-ui-components.git"
    },
    "homepage": "https://github.com/Adgytec/adgytec-web-ui-components/#/README.md"
}
